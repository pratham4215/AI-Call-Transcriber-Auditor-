# Copy to .env and fill in values

# Override data directories (defaults: subdirs of project root)
# DATA_DIR=/home/pratham/NEW/data
# TRANSCRIPTS_DIR=/home/pratham/NEW/transcripts
# REPORTS_DIR=/home/pratham/NEW/reports
# MODELS_DIR=/home/pratham/NEW/models

# ASR batch size (reduce if CUDA OOM)
# ASR_BATCH_SIZE=16

# Hugging Face access token required by the pyannote diarization model
# HF_TOKEN=hf_...

# Diarizer: pyannote (default) or the path to a fine-tuned Sortformer .nemo
# (the fine-tuned Nemotron-3 model needs the NeMo 3.1+ environment)
# DIARIZER=models/nemotron3_kataria.nemo

# Speech recognition model (default models/asr.nemo; models/best_v3.nemo = previous model)
# ASR_MODEL=models/best_v3.nemo

# Ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:32b

# Deterministic single-pass auditing (recommended production defaults)
# AUDIT_ENABLE_THINKING=false
# AUDIT_TEMPERATURE=0
# AUDIT_MAX_TOKENS=6144
# AUDIT_CONTEXT_TOKENS=32768

# Fine-tuned transcript-rating model (active | off; unset/empty = off)
# AUDIT_LORA_MODE=active
# AUDIT_LORA_MODEL=audit-lora-v1:latest

# Rating method (generate | brio; unset = generate). brio picks each rating by
# its probability instead of writing JSON: faster; falls back to generate on error
# AUDIT_SCORING=brio

# PostgreSQL CRM / call data (read-only). DATABASE_URL, if set, replaces the DB_* parts.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_TIMEZONE=+05:30
# Call-data source: auto (DB, falling back to CALL DATA.xlsx) | db | excel
# CRM_SOURCE=auto

# Flask
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# FLASK_DEBUG=false

# Kataria CRM API: AI endpoints (leads-ai, audit-report) and recording decrypt.
# Key (ktr-ai-...) is sent as "Authorization: Bearer <key>"
# CRM_API_URL=https://smr-api.katariacrm.com/crm
# CRM_API_TOKEN=
# Calls fetched at the same time. The CRM decrypt API takes ~7 s per recording;
# 4 in parallel measured 2.0 s per call instead of 10.2 s (2026-10-14)
# IMPORT_WORKERS=4

# Reviewer dashboard PINs. Required: with no value set, review deletion and
# admin sign-in stay locked.
# REVIEW_DELETE_PIN=
# REVIEW_ADMIN_PIN=

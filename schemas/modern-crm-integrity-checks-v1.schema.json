{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kataria.internal/schemas/modern-crm-integrity-checks-v1.json",
  "title": "Modern CRM Integrity Rule Inputs",
  "description": "Trusted deterministic check states supplied to the CRM integrity scorer; never generated by the audit LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": ["booking", "follow_up", "snr", "escalation", "cre_remarks", "customer_remarks"],
  "properties": {
    "booking": {"enum": ["pass", "minor_defect", "material_failure", "not_applicable"]},
    "follow_up": {"enum": ["pass", "minor_defect", "material_failure", "not_applicable"]},
    "snr": {"enum": ["pass", "minor_defect", "material_failure", "not_applicable"]},
    "escalation": {"enum": ["pass", "minor_defect", "material_failure", "not_applicable"]},
    "cre_remarks": {"enum": ["pass", "minor_defect", "material_failure"]},
    "customer_remarks": {"enum": ["pass", "minor_defect", "material_failure", "not_applicable"]}
  }
}